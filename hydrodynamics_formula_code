import numpy as np

def _eval_data(velocity, heading, turn_rate, rudder_angle):
    L = rudder_angle
    K = velocity
    C = heading
    H = 1023.6
    
    def M(coeff, density, area, velocity):
        A = 0.5 * coeff * density * area * velocity ** 2
        return A
    
    class I:
        def __init__(self, coeff_lift, coeff_drag, attack, area, density_fluid):
            self.coefficient_lift = coeff_lift
            self.coefficient_drag = coeff_drag
            self.angle_attack = attack
            self.area = area
            self.density_fluid = density_fluid
        
        def get_forces(self, attack, velocity):
            C = velocity
            B = attack
            B = np.angle(np.exp(1j * B))
            D = np.interp(B, self.angle_attack, self.coefficient_lift)
            E = np.interp(B, self.angle_attack, self.coefficient_drag)
            F = M(D, self.density_fluid, self.area, C)
            G = M(E, self.density_fluid, self.area, C)
            return F, G
    
    V = 1000
    W = 0.1
    X = 3
    Y = 0.25
    Z = -3
    B = np.deg2rad(np.arange(-180, 180.1, 0.1))
    N = 1.5 * np.sin(2 * B + np.sin(2 * B) / 2)
    J = 1 - np.cos(2 * B)
    a = np.zeros_like(J)
    O = 1.5 - 0.5 * np.cos(2 * B)
    P = np.where(np.abs(B) < np.pi / 2)
    O[P] = 1.25 - 0.75 * np.cos(2 * B[P])
    b = I(N, J, B, X, H)
    c = I(N, J, B, W, H)
    d = I(a, O, B, Y, H)
    D = np.array([np.cos(C), np.sin(C)])
    E = np.array(np.cross(np.array([D[0], D[1], 0]), np.array([0, 0, -1])))
    E = E[0:2]
    F = np.linalg.norm(K)
    Q = -K
    
    if F == 0:
        A = np.array([0, 1])
    else:
        A = Q / np.linalg.norm(Q)
    
    G = np.array(np.cross(np.array([-A[0], -A[1], 0]), np.array([0, 0, -1])))
    G = G[0:2]
    R = np.arctan2(D[1], D[0]) - np.arctan2(-A[1], -A[0])
    e, f = b.get_forces(R, F)
    g = G * e
    h = A * f
    S = np.array([np.cos(C + L), np.sin(C + L)])
    i = np.arctan2(S[1], S[0]) - np.arctan2(-A[1], -A[0])
    j, k = c.get_forces(i, F)
    T = G * j
    U = A * k
    t, l = d.get_forces(R, F)
    m = A * l
    n = T + U + g + h + m
    o = np.dot(T, E)
    p = np.dot(U, E)
    q = Z * (o + p)
    r = -V * turn_rate
    s = q + r
    return n, s
